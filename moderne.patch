+            }
+        });
+    }
+
+    @Override
+    public void onViewRecycled(@NonNull CardHolder holder) {
+        super.onViewRecycled(holder);
+
+        if (Liquid.isAlive(mActivity)) {
+            Glide.with(mActivity).clear(holder.image);
+        }
+    }
+
+    @Override
+    public int getItemCount() {
+        return mVideos.size();
+    }
+
+    /**
+     * Les vidéos ont déjà été ajoutées à la liste partagée : on prévient l'affichage.
+     */
+    public void notifyAppended(int start, int count) {
