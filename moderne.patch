+import com.liskovsoft.smartyoutubetv2.common.app.models.data.VideoGroup;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+import com.liskovsoft.smartyoutubetv2.tv.ui.common.LeanbackActivity;
+import io.reactivex.disposables.Disposable;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Liquid Glass : recherche (champ en verre, suggestions, résultats en rangées).
+ */
+public class LiquidSearchActivity extends LeanbackActivity implements LiquidCardAdapter.Listener {
+    private static final String TAG = LiquidSearchActivity.class.getSimpleName();
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mTagsTask = this::loadTags;
+    private Disposable mTagsAction;
+    private Disposable mSearchAction;
+
+    private EditText mInput;
+    private ProgressBar mLoading;
+    private ImageView mBackdrop;
+    private VerticalGridView mResults;
+    private LiquidRowAdapter mResultsAdapter;
+    private TagsAdapter mTagsAdapter;
+    private String mBackdropUrl;
+
+    @Override
+    protected void initTheme() {
+        setTheme(R.style.App_Theme_Liquid);
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.liquid_search);
+
+        mInput = findViewById(R.id.search_input);
+        mLoading = findViewById(R.id.search_loading);
+        mBackdrop = findViewById(R.id.search_backdrop);
+        mResults = findViewById(R.id.search_results);
+        HorizontalGridView tags = findViewById(R.id.search_tags);
+
+        mTagsAdapter = new TagsAdapter(this::search);
+        tags.setAdapter(mTagsAdapter);
+        tags.setHorizontalSpacing(Liquid.dp(this, 10));
+
+        mResultsAdapter = new LiquidRowAdapter(this, this);
+        mResults.setAdapter(mResultsAdapter);
+        mResults.setVerticalSpacing(Liquid.dp(this, 6));
+        mResults.setWindowAlignment(BaseGridView.WINDOW_ALIGN_LOW_EDGE);
+        mResults.setWindowAlignmentOffsetPercent(0);
+        mResults.setWindowAlignmentOffset(0);
+        mResults.setItemAlignmentOffsetPercent(0);
+
+        mInput.setOnEditorActionListener((v, actionId, event) -> {
+            boolean enter = event != null && event.getKeyCode() == KeyEvent.KEYCODE_ENTER && event.getAction() == KeyEvent.ACTION_DOWN;
+            if (actionId == EditorInfo.IME_ACTION_SEARCH || actionId == EditorInfo.IME_ACTION_DONE || enter) {
+                search(mInput.getText().toString());
+                return true;
+            }
+            return false;
+        });
+
+        mInput.addTextChangedListener(new TextWatcher() {
+            @Override
+            public void beforeTextChanged(CharSequence s, int start, int count, int after) {
+            }
+
+            @Override
+            public void onTextChanged(CharSequence s, int start, int before, int count) {
+            }
+
+            @Override
+            public void afterTextChanged(Editable s) {
+                mHandler.removeCallbacks(mTagsTask);
+                mHandler.postDelayed(mTagsTask, 300);
+            }
+        });
+
+        mInput.requestFocus();
+        mHandler.postDelayed(this::showKeyboard, 300);
+        loadTags();
+    }
+
+    @Override
+    public boolean onSearchRequested() {
+        mInput.requestFocus();
+        showKeyboard();
+        return true;
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        mHandler.removeCallbacksAndMessages(null);
+        RxHelper.disposeActions(mTagsAction, mSearchAction);
+    }
+
+    private void showKeyboard() {
+        InputMethodManager imm = (InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE);
+
+        if (imm != null && mInput != null) {
+            imm.showSoftInput(mInput, InputMethodManager.SHOW_IMPLICIT);
+        }
+    }
+
+    private void hideKeyboard() {
+        InputMethodManager imm = (InputMethodManager) getSystemService(Context.INPUT_METHOD_SERVICE);
+
+        if (imm != null && mInput != null) {
+            imm.hideSoftInputFromWindow(mInput.getWindowToken(), 0);
+        }
+    }
+
+    private void loadTags() {
+        RxHelper.disposeActions(mTagsAction);
+        mTagsAction = Liquid.service().getContentService().getSearchTagsObserve(mInput.getText().toString())
+                .subscribe(mTagsAdapter::setTags, error -> Log.e(TAG, "Tags error: %s", error.getMessage()));
+    }
+
+    private void search(String query) {
+        if (TextUtils.isEmpty(query) || TextUtils.isEmpty(query.trim())) {
+            return;
+        }
+
+        if (!query.equals(mInput.getText().toString())) {
+            mInput.setText(query);
+            mInput.setSelection(query.length());
+        }
+
+        hideKeyboard();
+        RxHelper.disposeActions(mSearchAction);
+        mResultsAdapter.clear();
+        mLoading.setVisibility(View.VISIBLE);
+        mBackdropUrl = null;
+
+        mSearchAction = Liquid.service().getContentService().getSearchObserve(query.trim())
+                .subscribe(this::addResults, error -> {
+                    Log.e(TAG, "Search error: %s", error.getMessage());
+                    mLoading.setVisibility(View.GONE);
+                }, () -> {
+                    mLoading.setVisibility(View.GONE);
+                    if (mResultsAdapter.getItemCount() > 0) {
+                        mResults.requestFocus();
+                    }
+                });
+    }
+
+    private void addResults(List<MediaGroup> groups) {
+        if (groups == null) {
+            return;
+        }
+
+        for (MediaGroup group : groups) {
+            VideoGroup videoGroup = VideoGroup.from(group);
+
+            if (videoGroup == null || videoGroup.getVideos() == null || videoGroup.getVideos().isEmpty()) {
+                continue;
+            }
+
+            String title = !TextUtils.isEmpty(group.getTitle()) ? group.getTitle() : getString(R.string.liquid_results);
+            mResultsAdapter.addRow(new LiquidRowAdapter.Row(title, new ArrayList<>(videoGroup.getVideos()), group));
+        }
+
+        mLoading.setVisibility(View.GONE);
+    }
+
+    @Override
+    public void onCardFocused(Video video) {
+        String url = video != null ? video.getCardImageUrl() : null;
+
+        if (url != null && !url.equals(mBackdropUrl)) {
+            mBackdropUrl = url;
+            Liquid.loadBlurred(this, mBackdrop, url);
+        }
+    }
+
+    @Override
+    public void onCardClicked(Video video) {
+        Liquid.open(this, video);
+    }
+
+    @Override
+    public void onCardLongClicked(Video video) {
+        LiquidVideoMenu.show(this, video, mResultsAdapter::removeVideo);
+    }
+
+    private static class TagsAdapter extends RecyclerView.Adapter<TagsAdapter.Holder> {
+        interface OnTag {
+            void onTag(String tag);
+        }
+
+        private final OnTag mOnTag;
+        private final List<String> mTags = new ArrayList<>();
+
+        TagsAdapter(OnTag onTag) {
+            mOnTag = onTag;
+        }
+
+        void setTags(List<String> tags) {
+            mTags.clear();
+            if (tags != null) {
+                for (String tag : tags) {
+                    if (!TextUtils.isEmpty(tag)) {
+                        mTags.add(tag);
+                    }
+                    if (mTags.size() >= 12) {
+                        break;
+                    }
+                }
+            }
+            notifyDataSetChanged();
+        }
+
+        @NonNull
+        @Override
+        public Holder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+            return new Holder((TextView) LayoutInflater.from(parent.getContext()).inflate(R.layout.liquid_tag, parent, false));
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull Holder holder, int position) {
+            String tag = mTags.get(position);
+            holder.text.setText(tag);
+            holder.text.setOnClickListener(v -> mOnTag.onTag(tag));
+        }
+
+        @Override
+        public int getItemCount() {
+            return mTags.size();
+        }
+
+        static class Holder extends RecyclerView.ViewHolder {
+            final TextView text;
+
+            Holder(TextView view) {
+                super(view);
+                text = view;
+            }
+        }
+    }
+}
