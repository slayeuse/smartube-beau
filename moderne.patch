+import com.liskovsoft.smartyoutubetv2.tv.R;
+import io.reactivex.disposables.Disposable;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Liquid Glass : menu de l'appui long sur une vidéo
+ * (lecture, infos, regarder plus tard, playlists, pas intéressé, ne pas recommander la chaîne, chaîne).
+ */
+public class LiquidVideoMenu {
+    private static final String TAG = LiquidVideoMenu.class.getSimpleName();
+
+    public interface OnVideoRemoved {
+        void onVideoRemoved(Video video);
+    }
+
+    private final Activity mActivity;
+    private final Video mVideo;
+    @Nullable
+    private final OnVideoRemoved mOnRemoved;
+    private final List<Disposable> mActions = new ArrayList<>();
+    private Dialog mDialog;
+    private TextView mTitle;
+    private TextView mSubtitle;
+    private EditText mInput;
+    private LinearLayout mItems;
+
+    private static class Item {
+        final String label;
+        final Runnable action;
+
+        Item(String label, Runnable action) {
+            this.label = label;
+            this.action = action;
+        }
+    }
+
+    private LiquidVideoMenu(Activity activity, Video video, @Nullable OnVideoRemoved onRemoved) {
+        mActivity = activity;
+        mVideo = video;
+        mOnRemoved = onRemoved;
+    }
+
+    public static void show(Activity activity, Video video, @Nullable OnVideoRemoved onRemoved) {
+        if (!Liquid.isAlive(activity) || video == null) {
+            return;
+        }
+
+        new LiquidVideoMenu(activity, video, onRemoved).create();
+    }
+
+    private void create() {
+        mDialog = new Dialog(mActivity, android.R.style.Theme_Translucent_NoTitleBar_Fullscreen);
+        View root = LayoutInflater.from(mActivity).inflate(R.layout.liquid_menu, null);
+        mDialog.setContentView(root);
+
+        Window window = mDialog.getWindow();
+        if (window != null) {
+            window.setBackgroundDrawable(new ColorDrawable(Color.TRANSPARENT));
+            window.setLayout(WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT);
+        }
+
+        mTitle = root.findViewById(R.id.menu_title);
+        mSubtitle = root.findViewById(R.id.menu_subtitle);
+        mInput = root.findViewById(R.id.menu_input);
+        mItems = root.findViewById(R.id.menu_items);
+
+        mDialog.setOnDismissListener(d -> RxHelper.disposeActions(mActions));
+
+        showMain();
+        mDialog.show();
+    }
+
+    private void dismiss() {
+        if (mDialog != null && mDialog.isShowing()) {
+            try {
+                mDialog.dismiss();
+            } catch (IllegalArgumentException e) {
+                // fenêtre déjà détachée
+            }
+        }
+    }
+
+    private String str(int resId) {
+        return mActivity.getString(resId);
+    }
+
+    private void setPage(String title, String subtitle, List<Item> items) {
+        mTitle.setText(title);
+        mSubtitle.setText(subtitle);
+        mSubtitle.setVisibility(TextUtils.isEmpty(subtitle) ? View.GONE : View.VISIBLE);
+        mInput.setVisibility(View.GONE);
+        mItems.removeAllViews();
+
+        LayoutInflater inflater = LayoutInflater.from(mActivity);
+        View first = null;
+
+        for (final Item item : items) {
+            TextView view = (TextView) inflater.inflate(R.layout.liquid_menu_item, mItems, false);
+            view.setText(item.label);
+            view.setOnClickListener(v -> item.action.run());
+            mItems.addView(view);
+
+            if (first == null) {
+                first = view;
+            }
+        }
+
+        if (first != null) {
+            first.requestFocus();
+        }
+    }
+
+    // ----- Page principale -----
+
+    private void showMain() {
+        List<Item> items = new ArrayList<>();
+        final boolean playable = Liquid.isPlayable(mVideo);
+
+        items.add(new Item(str(R.string.liquid_menu_play), () -> {
+            dismiss();
+            Liquid.open(mActivity, mVideo);
+        }));
+
+        if (playable) {
+            items.add(new Item(str(R.string.liquid_menu_details), () -> {
+                dismiss();
+                LiquidDetailsActivity.start(mActivity, mVideo, false);
+            }));
+            items.add(new Item(str(R.string.liquid_menu_watch_later), this::addToWatchLater));
+            items.add(new Item(str(R.string.liquid_menu_add_playlist), this::showPlaylists));
+        }
+
+        MediaItem mediaItem = mVideo.mediaItem;
+
+        if (mediaItem != null && (mediaItem.getFeedbackToken() != null || mediaItem.getFeedbackEndpoint() != null)) {
+            items.add(new Item(str(R.string.liquid_menu_not_interested), this::notInterested));
+        }
+
+        if (mediaItem != null && (mediaItem.getFeedbackToken2() != null || mediaItem.getFeedbackEndpoint() != null)) {
+            items.add(new Item(str(R.string.liquid_menu_not_channel), this::notRecommendChannel));
+        }
+
+        if (mVideo.channelId != null) {
+            items.add(new Item(str(R.string.liquid_menu_channel), () -> {
+                dismiss();
+                LiquidChannelActivity.start(mActivity, mVideo.channelId, mVideo);
+            }));
+        }
+
+        setPage(mVideo.getTitle(), Liquid.author(mVideo), items);
+    }
+
+    private boolean checkSigned() {
+        boolean signed = false;
+
+        try {
+            signed = Liquid.service().getSignInService().isSigned();
+        } catch (RuntimeException e) {
+            // pas de compte
+        }
+
+        if (!signed) {
+            MessageHelpers.showMessage(mActivity, str(R.string.liquid_menu_sign_in));
+        }
+
+        return signed;
+    }
+
+    private MediaItemService items() {
+        return Liquid.service().getMediaItemService();
+    }
+
+    // ----- Regarder plus tard -----
+
+    private void addToWatchLater() {
+        if (!checkSigned()) {
+            return;
+        }
+
+        MediaServiceManager.instance().addToWatchLaterPlaylist(mVideo);
+        MessageHelpers.showMessage(mActivity, str(R.string.liquid_menu_done_watch_later));
+        dismiss();
+    }
+
+    // ----- Playlists -----
+
+    private void showPlaylists() {
+        if (!checkSigned()) {
+            return;
+        }
+
+        List<Item> loading = new ArrayList<>();
+        loading.add(new Item(str(R.string.liquid_menu_loading), () -> { }));
+        setPage(str(R.string.liquid_menu_playlists), mVideo.getTitle(), loading);
+
+        mActions.add(items().getPlaylistsInfoObserve(mVideo.videoId)
+                .subscribe(this::onPlaylists, error -> {
+                    Log.e(TAG, "Playlists error: %s", error.getMessage());
+                    dismiss();
+                }));
+    }
+
+    private void onPlaylists(List<PlaylistInfo> playlists) {
+        List<Item> items = new ArrayList<>();
+        items.add(new Item(str(R.string.liquid_menu_new_playlist), this::showNewPlaylist));
+
+        if (playlists != null) {
+            for (final PlaylistInfo playlist : playlists) {
+                if (playlist == null || playlist.getPlaylistId() == null) {
+                    continue;
+                }
+
+                final boolean selected = playlist.isSelected();
+                String label = (selected ? "✓  " : "") + playlist.getTitle();
+                items.add(new Item(label, () -> togglePlaylist(playlist.getPlaylistId(), selected)));
+            }
+        }
+
+        setPage(str(R.string.liquid_menu_playlists), mVideo.getTitle(), items);
+    }
+
+    private void togglePlaylist(String playlistId, boolean isSelected) {
+        // Pas ajouté à mActions : la requête doit continuer après la fermeture du menu
+        RxHelper.execute(isSelected ?
+                items().removeFromPlaylistObserve(playlistId, mVideo.videoId) :
+                (mVideo.mediaItem != null ? items().addToPlaylistObserve(playlistId, mVideo.mediaItem) : items().addToPlaylistObserve(playlistId, mVideo.videoId)));
+        MessageHelpers.showMessage(mActivity, str(isSelected ? R.string.liquid_menu_done_removed : R.string.liquid_menu_done_added));
+        dismiss();
+    }
+
+    private void showNewPlaylist() {
+        List<Item> items = new ArrayList<>();
+        items.add(new Item(str(R.string.liquid_menu_create), this::createPlaylist));
+        setPage(str(R.string.liquid_menu_new_playlist), mVideo.getTitle(), items);
+
+        mInput.setVisibility(View.VISIBLE);
+        mInput.setText("");
+        mInput.setHint(R.string.liquid_menu_playlist_name);
+        mInput.setOnEditorActionListener((v, actionId, event) -> {
+            if (actionId == EditorInfo.IME_ACTION_DONE) {
+                createPlaylist();
+                return true;
+            }
+            return false;
+        });
+        mInput.requestFocus();
+    }
+
+    private void createPlaylist() {
+        String name = mInput.getText() != null ? mInput.getText().toString().trim() : "";
+
+        if (name.isEmpty()) {
+            mInput.requestFocus();
+            return;
+        }
+
+        RxHelper.execute(mVideo.mediaItem != null ?
+                items().createPlaylistObserve(name, mVideo.mediaItem) :
+                items().createPlaylistObserve(name, mVideo.videoId));
+        MessageHelpers.showMessage(mActivity, str(R.string.liquid_menu_done_added));
+        dismiss();
+    }
+
+    // ----- Pas intéressé / ne pas recommander la chaîne -----
+
+    private void notInterested() {
+        MediaItem mediaItem = mVideo.mediaItem;
+
+        if (mediaItem.getFeedbackEndpoint() == null) {
+            askReasons(mediaItem.getFeedbackToken());
+        } else {
+            mActions.add(items().getFeedbackTokensObserve(mediaItem.getFeedbackEndpoint())
+                    .subscribe(tokens -> {
+                        if (tokens != null && !tokens.isEmpty()) {
+                            askReasons(tokens.get(0));
+                        }
+                    }, error -> Log.e(TAG, "Feedback error: %s", error.getMessage())));
+        }
+    }
+
+    private void askReasons(final String token) {
+        if (token == null) {
+            return;
+        }
+
+        mActions.add(items().getFeedbackReasonsObserve(token)
+                .subscribe(reasons -> {
+                    if (reasons == null || reasons.getItems() == null || reasons.getItems().isEmpty()) {
+                        markHidden(token, R.string.liquid_menu_done_hidden);
+                        return;
+                    }
+
+                    List<Item> items = new ArrayList<>();
+                    for (final FeedbackItem reason : reasons.getItems()) {
+                        items.add(new Item(reason.getTitle(), () -> markHidden(reason.getToken(), R.string.liquid_menu_done_hidden)));
+                    }
+
+                    String title = !TextUtils.isEmpty(reasons.getTitle()) ? reasons.getTitle() : str(R.string.liquid_menu_why);
+                    setPage(title, mVideo.getTitle(), items);
+                }, error -> {
+                    Log.e(TAG, "Reasons error: %s", error.getMessage());
+                    markHidden(token, R.string.liquid_menu_done_hidden);
+                }));
+    }
+
+    private void notRecommendChannel() {
+        MediaItem mediaItem = mVideo.mediaItem;
+
+        if (mediaItem.getFeedbackEndpoint() == null) {
+            markHidden(mediaItem.getFeedbackToken2(), R.string.liquid_menu_done_channel);
+        } else {
+            mActions.add(items().getFeedbackTokensObserve(mediaItem.getFeedbackEndpoint())
+                    .subscribe(tokens -> {
+                        if (tokens != null && tokens.size() >= 2) {
+                            markHidden(tokens.get(1), R.string.liquid_menu_done_channel);
+                        }
+                    }, error -> Log.e(TAG, "Feedback error: %s", error.getMessage())));
+        }
+    }
+
+    private void markHidden(String token, int messageResId) {
+        if (token != null) {
+            RxHelper.execute(items().markAsNotInterestedObserve(token));
+        }
+
+        MessageHelpers.showMessage(mActivity, str(messageResId));
+
+        if (mOnRemoved != null) {
+            mOnRemoved.onVideoRemoved(mVideo);
+        }
+
+        dismiss();
+    }
+}
