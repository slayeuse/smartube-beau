+
+/**
+ * Liquid Glass : branchement des nouveaux écrans dans SmartTube.
+ */
+public final class LiquidSetup {
+    private LiquidSetup() {
+    }
+
+    public static void init(Context context) {
+        // Boutons « commentaires » et « infos » du lecteur → page vidéo Liquid
+        LiquidHooks.setDetailsOpener(LiquidDetailsActivity::startFromPlayer);
+        // Pages de chaîne → page de chaîne Liquid
+        LiquidHooks.setChannelOpener(LiquidChannelActivity::start);
+        // Playlists → même page, en mode playlist
+        LiquidHooks.setPlaylistOpener(LiquidChannelActivity::startPlaylist);
+    }
+
+    public static void registerViews(ViewManager viewManager) {
+        viewManager.setRoot(LiquidHomeActivity.class);
+        viewManager.register(LiquidHomeActivity.class, LiquidHomeActivity.class);
+        viewManager.register(LiquidDetailsActivity.class, LiquidDetailsActivity.class, LiquidHomeActivity.class);
+        viewManager.register(LiquidSearchActivity.class, LiquidSearchActivity.class, LiquidHomeActivity.class);
+        viewManager.register(LiquidAccountActivity.class, LiquidAccountActivity.class, LiquidHomeActivity.class);
+        viewManager.register(LiquidChannelActivity.class, LiquidChannelActivity.class, LiquidHomeActivity.class);
+    }
+}
