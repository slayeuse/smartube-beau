+            if (mFromPlayer) {
+                finishReally(); // retour au lecteur, la vidéo continue
+            } else {
+                Liquid.open(this, mVideo);
+            }
+        });
+        Liquid.bindFocusScale(play, 1.1f, null);
+
+        mSubscribe.setOnClickListener(v -> toggleSubscribe());
+        mChannel.setOnClickListener(v -> {
+            String channelId = mMetadata != null && mMetadata.getChannelId() != null ? mMetadata.getChannelId() : mVideo.channelId;
+            LiquidChannelActivity.start(this, channelId, mVideo);
+        });
+        mLike.setOnClickListener(v -> toggleLike());
+        mLike.setVisibility(mVideo.mediaItem != null ? View.VISIBLE : View.GONE);
+
+        bindVideo();
+        loadMetadata();
+
+        if (!mFocusComments) {
+            play.requestFocus();
+        }
+    }
+
+    /**
+     * Description complète dans un grand panneau en verre (haut/bas pour défiler, retour pour fermer).
+     */
+    private void showFullDescription() {
+        CharSequence text = mDescription.getText();
+
+        if (TextUtils.isEmpty(text)) {
+            return;
+        }
+
+        mOverlayText.setText(text);
+        mOverlay.setVisibility(View.VISIBLE);
+        View scroll = findViewById(R.id.details_overlay_scroll);
+        scroll.scrollTo(0, 0);
+        scroll.requestFocus();
+    }
+
+    @Override
+    public void finish() {
+        // Retour : on ferme d'abord la description complète
+        if (mOverlay != null && mOverlay.getVisibility() == View.VISIBLE) {
+            mOverlay.setVisibility(View.GONE);
+            View card = findViewById(R.id.details_description_card);
+            if (card != null) {
+                card.requestFocus();
+            }
+            return;
+        }
+
+        super.finish();
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        RxHelper.disposeActions(mActions);
+        RxHelper.disposeActions(mMoreCommentsAction);
+    }
+
+    private void bindVideo() {
+        mTitle.setText(mVideo.getTitle());
+        mChannel.setText(Liquid.author(mVideo));
+        mMeta.setText(Liquid.meta(mVideo));
+        Liquid.loadImage(this, mThumb, Liquid.bigImageUrl(mVideo), mVideo.getCardImageUrl());
+        Liquid.loadBlurred(this, mBackdrop, mVideo.getCardImageUrl());
+    }
+
+    private void loadMetadata() {
+        mActions.add(Liquid.service().getMediaItemService().getMetadataObserve(mVideo.videoId)
+                .subscribe(this::onMetadata, error -> {
+                    Log.e(TAG, "Metadata error: %s", error.getMessage());
+                    showNoComments();
+                }));
+    }
+
+    private void onMetadata(MediaItemMetadata metadata) {
+        if (metadata == null) {
+            return;
+        }
+
+        mMetadata = metadata;
+
+        if (!TextUtils.isEmpty(metadata.getTitle())) {
+            mTitle.setText(metadata.getTitle());
+        }
+
+        if (!TextUtils.isEmpty(metadata.getAuthor())) {
+            mChannel.setText(metadata.getAuthor());
+        }
+
+        List<String> parts = new ArrayList<>();
+        addPart(parts, metadata.getSubscriberCount());
+        addPart(parts, metadata.getViewCount());
+        addPart(parts, metadata.getPublishedDate());
+        if (!parts.isEmpty()) {
+            mMeta.setText(TextUtils.join(" · ", parts));
+        }
+
+        mDescription.setText(metadata.getDescription());
+        Liquid.loadCircle(this, mAvatar, metadata.getAuthorImageUrl());
+
+        mIsSubscribed = metadata.isSubscribed();
+        mIsLiked = metadata.getLikeStatus() == MediaItemMetadata.LIKE_STATUS_LIKE;
+        updateButtons();
+
+        String commentsKey = metadata.getCommentsKey();
+
+        if (commentsKey == null) {
+            showNoComments();
+        } else {
+            loadComments(commentsKey, true);
+        }
+    }
+
+    private static void addPart(List<String> parts, String value) {
+        if (!TextUtils.isEmpty(value)) {
+            parts.add(value);
+        }
+    }
+
+    private void updateButtons() {
+        mSubscribe.setText(mIsSubscribed ? R.string.liquid_subscribed : R.string.liquid_subscribe);
+        mLike.setText(mIsLiked ? R.string.liquid_liked : R.string.liquid_like);
+    }
+
+    private void toggleSubscribe() {
+        String channelId = mMetadata != null && mMetadata.getChannelId() != null ? mMetadata.getChannelId() : mVideo.channelId;
+
+        if (channelId == null) {
+            return;
+        }
+
+        mIsSubscribed = !mIsSubscribed;
+        updateButtons();
+
+        mActions.add(RxHelper.execute(mIsSubscribed ?
+                Liquid.service().getMediaItemService().subscribeObserve(channelId) :
+                Liquid.service().getMediaItemService().unsubscribeObserve(channelId)));
+    }
+
+    private void toggleLike() {
+        if (mVideo.mediaItem == null) {
+            return;
+        }
+
+        mIsLiked = !mIsLiked;
+        updateButtons();
+
+        mActions.add(RxHelper.execute(mIsLiked ?
+                Liquid.service().getMediaItemService().setLikeObserve(mVideo.mediaItem) :
+                Liquid.service().getMediaItemService().removeLikeObserve(mVideo.mediaItem)));
+    }
+
+    // ----- Commentaires -----
+
+    private void loadComments(String key, boolean first) {
+        Disposable action = Liquid.service().getCommentsService().getCommentsObserve(key)
+                .subscribe(group -> onComments(group, first), error -> {
+                    Log.e(TAG, "Comments error: %s", error.getMessage());
+                    if (first) {
+                        showNoComments();
+                    }
+                });
+
+        if (first) {
+            mActions.add(action);
+        } else {
+            mMoreCommentsAction = action;
+        }
+    }
+
+    private void loadMoreComments() {
+        if (mNextCommentsKey == null || RxHelper.isAnyActionRunning(mMoreCommentsAction)) {
+            return;
+        }
+
+        String key = mNextCommentsKey;
+        mNextCommentsKey = null;
+        loadComments(key, false);
+    }
+
+    private void onComments(CommentGroup group, boolean first) {
+        if (group == null) {
+            if (first) {
+                showNoComments();
+            }
+            return;
+        }
+
+        mNextCommentsKey = group.getNextCommentsKey();
+        List<CommentItem> comments = group.getComments();
+
+        if (comments != null) {
+            List<CommentItem> valid = new ArrayList<>();
+            for (CommentItem item : comments) {
+                if (item != null && !item.isEmpty()) {
+                    valid.add(item);
+                }
+            }
+            mCommentsAdapter.add(valid);
+        }
+
+        if (first && mCommentsAdapter.getItemCount() == 0) {
+            showNoComments();
+        } else if (first) {
+            mCommentsEmpty.setVisibility(View.GONE);
+
+            if (mFocusComments) {
+                mComments.requestFocus();
+            }
+        }
+    }
+
+    private void showNoComments() {
+        if (mCommentsAdapter.getItemCount() == 0) {
+            mCommentsEmpty.setText(R.string.liquid_no_comments);
+            mCommentsEmpty.setVisibility(View.VISIBLE);
+        }
+    }
+
+    private static class CommentsAdapter extends RecyclerView.Adapter<CommentsAdapter.Holder> {
+        private final Activity mActivity;
+        private final List<CommentItem> mItems = new ArrayList<>();
+
+        CommentsAdapter(Activity activity) {
+            mActivity = activity;
+        }
+
+        void add(List<CommentItem> items) {
+            int start = mItems.size();
+            mItems.addAll(items);
+            notifyItemRangeInserted(start, items.size());
+        }
+
+        @NonNull
+        @Override
+        public Holder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+            return new Holder(LayoutInflater.from(parent.getContext()).inflate(R.layout.liquid_comment, parent, false));
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull Holder holder, int position) {
+            CommentItem item = mItems.get(position);
+            holder.author.setText(item.getAuthorName());
+            holder.message.setText(item.getMessage());
+
+            List<String> parts = new ArrayList<>();
+            if (!TextUtils.isEmpty(item.getLikeCount())) {
+                parts.add("♥ " + item.getLikeCount());
+            }
+            addPart(parts, item.getPublishedDate());
+            if (!TextUtils.isEmpty(item.getReplyCount())) {
+                parts.add(item.getReplyCount() + " réponses");
+            }
+            holder.meta.setText(TextUtils.join(" · ", parts));
+            holder.meta.setVisibility(parts.isEmpty() ? View.GONE : View.VISIBLE);
+
+            holder.avatar.setImageResource(R.drawable.liquid_avatar_placeholder);
+            Liquid.loadCircle(mActivity, holder.avatar, item.getAuthorPhoto());
+        }
+
+        @Override
+        public int getItemCount() {
+            return mItems.size();
+        }
+
+        static class Holder extends RecyclerView.ViewHolder {
+            final ImageView avatar;
+            final TextView author;
+            final TextView message;
+            final TextView meta;
+
+            Holder(View view) {
+                super(view);
+                avatar = view.findViewById(R.id.comment_avatar);
+                author = view.findViewById(R.id.comment_author);
+                message = view.findViewById(R.id.comment_message);
+                meta = view.findViewById(R.id.comment_meta);
+            }
+        }
+    }
+}
