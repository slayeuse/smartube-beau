+package com.liskovsoft.smartyoutubetv2.tv.ui.liquid;
+
+import android.app.Activity;
+import android.text.TextUtils;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.ImageView;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.RecyclerView;
+import com.bumptech.glide.Glide;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+import com.liskovsoft.smartyoutubetv2.tv.util.ModerneStyle;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Liquid Glass : vignettes d'une rangée.
+ */
+public class LiquidCardAdapter extends RecyclerView.Adapter<LiquidCardAdapter.CardHolder> {
+    public interface Listener {
+        void onCardFocused(Video video);
+        void onCardClicked(Video video);
+        void onCardLongClicked(Video video);
+    }
+
+    private final Activity mActivity;
+    private final Listener mListener;
+    private final List<Video> mVideos;
+    private final Runnable mOnNearEnd;
+
+    public LiquidCardAdapter(Activity activity, List<Video> videos, Listener listener) {
+        this(activity, videos, listener, null);
+    }
+
+    /**
+     * @param videos liste partagée avec la rangée (la suite y est ajoutée)
+     * @param onNearEnd appelé quand on approche de la fin : charger la suite
+     */
+    public LiquidCardAdapter(Activity activity, List<Video> videos, Listener listener, Runnable onNearEnd) {
+        mActivity = activity;
+        mListener = listener;
+        mVideos = videos != null ? videos : new ArrayList<>();
+        mOnNearEnd = onNearEnd;
+    }
+
+    @NonNull
+    @Override
+    public CardHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+        View view = LayoutInflater.from(parent.getContext()).inflate(R.layout.liquid_card, parent, false);
+        return new CardHolder(view);
+    }
+
+    @Override
+    public void onBindViewHolder(@NonNull CardHolder holder, int position) {
+        final Video video = mVideos.get(position);
+
+        // Défilement infini : on demande la suite avant d'arriver au bout
+        if (mOnNearEnd != null && position >= getItemCount() - 4) {
+            holder.itemView.post(mOnNearEnd);
+        }
+
+        holder.title.setText(video.getTitle());
+        holder.meta.setText(Liquid.meta(video));
+
+        String badge = video.isLive ? "EN DIRECT" : video.badge;
+        holder.badge.setText(badge);
+        holder.badge.setVisibility(TextUtils.isEmpty(badge) ? View.GONE : View.VISIBLE);
+
+        if (video.percentWatched > 0) {
+            holder.progress.setVisibility(View.VISIBLE);
+            holder.progress.setProgress(Math.max(3, Math.round(video.percentWatched)));
+        } else {
+            holder.progress.setVisibility(View.GONE);
+        }
+
+        if (Liquid.isAlive(mActivity)) {
+            Glide.with(mActivity)
+                    .load(video.getCardImageUrl())
+                    .into(holder.image);
+        }
+
+        holder.itemView.setOnClickListener(v -> mListener.onCardClicked(video));
+        holder.itemView.setOnLongClickListener(v -> {
+            mListener.onCardLongClicked(video);
+            return true;
+        });
+        Liquid.bindFocusScale(holder.itemView, 1.08f, (v, hasFocus) -> {
+            holder.title.setTextColor(hasFocus ? 0xFFFFFFFF : 0xB3FFFFFF);
+            if (hasFocus) {
