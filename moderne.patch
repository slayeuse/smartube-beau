+package com.liskovsoft.smartyoutubetv2.tv.ui.liquid;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+import androidx.leanback.widget.BaseGridView;
+import androidx.leanback.widget.VerticalGridView;
+import com.liskovsoft.mediaserviceinterfaces.data.MediaGroup;
+import com.liskovsoft.sharedutils.mylogger.Log;
+import com.liskovsoft.sharedutils.rx.RxHelper;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.VideoGroup;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+import com.liskovsoft.smartyoutubetv2.tv.ui.common.LeanbackActivity;
+import io.reactivex.disposables.Disposable;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Liquid Glass : page de chaîne (en-tête + rangées de vidéos).
+ */
+public class LiquidChannelActivity extends LeanbackActivity implements LiquidCardAdapter.Listener {
+    private static final String TAG = LiquidChannelActivity.class.getSimpleName();
+    private static final String EXTRA_CHANNEL_ID = "channel_id";
+    private static final String EXTRA_PLAYLIST = "playlist_mode";
+    private static final int GRID_ROW_SIZE = 5;
+    private static Video sPendingChannel;
+
+    private final List<Disposable> mActions = new ArrayList<>();
+    private String mChannelId;
+    private Video mChannel;
+    private boolean mIsSubscribed;
+    private boolean mSubscriptionChecked;
+    private boolean mPlaylistMode;
+    private MediaGroup mPlaylistGroup;
+    private List<Video> mPendingVideos = new ArrayList<>();
+    private Disposable mContinueAction;
+    private Video mFocusedVideo;
+    private final Runnable mBackdropTask = this::updateBackdrop;
+
+    private ImageView mBackdrop;
+    private ImageView mAvatar;
+    private TextView mName;
+    private TextView mMeta;
+    private TextView mSubscribe;
+    private TextView mMessage;
+    private ProgressBar mLoading;
+    private VerticalGridView mRowsView;
+    private LiquidRowAdapter mRowsAdapter;
+
+    public static boolean start(Context context, String channelId, Video channel) {
+        if (channelId == null) {
+            return false;
+        }
+
+        sPendingChannel = channel;
+        Intent intent = new Intent(context, LiquidChannelActivity.class);
+        intent.putExtra(EXTRA_CHANNEL_ID, channelId);
+
+        if (!(context instanceof Activity)) {
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        }
+
+        context.startActivity(intent);
+        return true;
+    }
+
+    /**
+     * Page de playlist (même écran, sans bouton d'abonnement, vidéos en grille).
+     */
+    public static boolean startPlaylist(Context context, Video playlist) {
+        if (playlist == null) {
+            return false;
+        }
+
+        sPendingChannel = playlist;
+        Intent intent = new Intent(context, LiquidChannelActivity.class);
+        intent.putExtra(EXTRA_PLAYLIST, true);
+
+        if (!(context instanceof Activity)) {
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+        }
+
+        context.startActivity(intent);
+        return true;
+    }
+
+    @Override
+    protected void initTheme() {
+        setTheme(R.style.App_Theme_Liquid);
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.liquid_channel);
+
+        mChannelId = getIntent().getStringExtra(EXTRA_CHANNEL_ID);
+        mChannel = sPendingChannel;
+        mPlaylistMode = getIntent().getBooleanExtra(EXTRA_PLAYLIST, false);
+
+        mBackdrop = findViewById(R.id.channel_backdrop);
+        mAvatar = findViewById(R.id.channel_avatar);
+        mName = findViewById(R.id.channel_name);
+        mMeta = findViewById(R.id.channel_meta);
+        mSubscribe = findViewById(R.id.channel_subscribe);
+        mMessage = findViewById(R.id.channel_message);
+        mLoading = findViewById(R.id.channel_loading);
+        mRowsView = findViewById(R.id.channel_rows);
+
+        mRowsAdapter = new LiquidRowAdapter(this, this);
+        mRowsView.setAdapter(mRowsAdapter);
+        mRowsView.setVerticalSpacing(Liquid.dp(this, 6));
+        mRowsView.setWindowAlignment(BaseGridView.WINDOW_ALIGN_LOW_EDGE);
+        mRowsView.setWindowAlignmentOffsetPercent(0);
+        mRowsView.setWindowAlignmentOffset(0);
+        mRowsView.setItemAlignmentOffsetPercent(0);
+
+        mSubscribe.setOnClickListener(v -> toggleSubscribe());
+
+        if (mPlaylistMode) {
+            bindPlaylistHeader();
+            loadPlaylist();
+            return;
+        }
+
+        bindHeader();
+        loadRows();
+    }
+
+    // ----- Mode playlist -----
+
+    private void bindPlaylistHeader() {
+        mSubscribe.setVisibility(View.GONE);
+        mName.setText(mChannel != null ? mChannel.getTitle() : getString(R.string.liquid_menu_playlists));
+        mMeta.setText(mChannel != null ? Liquid.meta(mChannel) : "");
+        mAvatar.setVisibility(View.GONE);
+
+        if (mChannel != null) {
+            Liquid.loadBlurred(this, mBackdrop, mChannel.getCardImageUrl());
+        }
+
+        // Charger la suite quand on descend vers les dernières rangées
+        mRowsView.setOnChildViewHolderSelectedListener(new androidx.leanback.widget.OnChildViewHolderSelectedListener() {
+            @Override
+            public void onChildViewHolderSelected(androidx.recyclerview.widget.RecyclerView parent,
+                                                  androidx.recyclerview.widget.RecyclerView.ViewHolder child, int position, int subposition) {
+                if (position >= mRowsAdapter.getItemCount() - 2) {
+                    continuePlaylist();
+                }
+            }
+        });
+    }
+
+    private void loadPlaylist() {
+        io.reactivex.Observable<MediaGroup> observable = mChannel != null ?
+                com.liskovsoft.smartyoutubetv2.common.app.presenters.ChannelUploadsPresenter.instance(this).obtainUploadsObservable(mChannel) : null;
+
+        if (observable == null) {
+            showMessage(getString(R.string.liquid_loading_error));
+            return;
+        }
+
+        mLoading.setVisibility(View.VISIBLE);
+        mActions.add(observable.subscribe(this::addPlaylistGroup, error -> {
+            Log.e(TAG, "Playlist error: %s", error.getMessage());
+            mLoading.setVisibility(View.GONE);
+            if (mRowsAdapter.getItemCount() == 0) {
+                showMessage(getString(R.string.liquid_loading_error));
+            }
+        }, () -> {
+            mLoading.setVisibility(View.GONE);
+            if (mRowsAdapter.getItemCount() == 0 && mPendingVideos.isEmpty()) {
+                showMessage(getString(R.string.liquid_empty));
+            }
+        }));
+    }
+
+    private void addPlaylistGroup(MediaGroup group) {
+        if (group == null) {
+            return;
+        }
+
+        boolean wasEmpty = mRowsAdapter.getItemCount() == 0;
+        mPlaylistGroup = group;
+        List<Video> videos = new ArrayList<>(mPendingVideos);
+        videos.addAll(LiquidRowAdapter.toVideos(group));
+        mPendingVideos = new ArrayList<>();
+
+        int index = 0;
+        while (videos.size() - index >= GRID_ROW_SIZE) {
+            mRowsAdapter.addRow(new LiquidRowAdapter.Row(null, new ArrayList<>(videos.subList(index, index + GRID_ROW_SIZE))));
+            index += GRID_ROW_SIZE;
+        }
+
+        if (index < videos.size()) {
+            List<Video> rest = new ArrayList<>(videos.subList(index, videos.size()));
+
+            if (group.getNextPageKey() == null) {
+                mRowsAdapter.addRow(new LiquidRowAdapter.Row(null, rest));
+            } else {
+                mPendingVideos = rest;
+            }
+        }
+
+        mLoading.setVisibility(View.GONE);
+
+        if (wasEmpty && mRowsAdapter.getItemCount() > 0) {
+            mRowsView.requestFocus();
+        }
+    }
+
+    private void continuePlaylist() {
+        if (mPlaylistGroup == null || mPlaylistGroup.getNextPageKey() == null || RxHelper.isAnyActionRunning(mContinueAction)) {
+            return;
+        }
+
+        MediaGroup current = mPlaylistGroup;
+        mPlaylistGroup = null;
+        mContinueAction = Liquid.service().getContentService().continueGroupObserve(current)
+                .subscribe(this::addPlaylistGroup, error -> Log.e(TAG, "Playlist continue error: %s", error.getMessage()));
+        mActions.add(mContinueAction);
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        RxHelper.disposeActions(mActions);
+    }
+
+    private void bindHeader() {
+        String name = null;
+
+        if (mChannel != null) {
+            // Vignette de chaîne : le titre est le nom de la chaîne. Vignette de vidéo : l'auteur.
+            name = mChannel.hasVideo() ? Liquid.author(mChannel) : mChannel.getTitle();
+
+            if (!mChannel.hasVideo()) {
+                Liquid.loadCircle(this, mAvatar, mChannel.getCardImageUrl());
+                Liquid.loadBlurred(this, mBackdrop, mChannel.getCardImageUrl());
+            }
+        }
+
+        mName.setText(!TextUtils.isEmpty(name) ? name : getString(R.string.liquid_channel));
+        updateSubscribe();
+    }
+
+    private void loadRows() {
+        if (mChannelId == null) {
+            showMessage(getString(R.string.liquid_loading_error));
+            return;
+        }
+
+        mLoading.setVisibility(View.VISIBLE);
+        mActions.add(Liquid.service().getContentService().getChannelObserve(mChannelId)
+                .subscribe(this::addGroups, error -> {
+                    Log.e(TAG, "Channel error: %s", error.getMessage());
+                    mLoading.setVisibility(View.GONE);
+                    if (mRowsAdapter.getItemCount() == 0) {
+                        showMessage(getString(R.string.liquid_loading_error));
+                    }
+                }, () -> {
+                    mLoading.setVisibility(View.GONE);
+                    if (mRowsAdapter.getItemCount() == 0) {
+                        showMessage(getString(R.string.liquid_empty));
+                    }
+                }));
+    }
+
+    private void addGroups(List<MediaGroup> groups) {
+        if (groups == null) {
+            return;
+        }
+
+        boolean wasEmpty = mRowsAdapter.getItemCount() == 0;
+
+        for (MediaGroup group : groups) {
+            VideoGroup videoGroup = VideoGroup.from(group);
+
+            if (videoGroup == null || videoGroup.getVideos() == null || videoGroup.getVideos().isEmpty()) {
+                continue;
+            }
+
+            mRowsAdapter.addRow(new LiquidRowAdapter.Row(group.getTitle(), new ArrayList<>(videoGroup.getVideos()), group));
+        }
+
+        mLoading.setVisibility(View.GONE);
+
+        if (wasEmpty && mRowsAdapter.getItemCount() > 0) {
+            List<Video> first = mRowsAdapter.getRows().get(0).videos;
+
+            if (!first.isEmpty()) {
+                Video video = first.get(0);
+                Liquid.loadBlurred(this, mBackdrop, video.getCardImageUrl());
+
+                if (TextUtils.isEmpty(mName.getText()) || getString(R.string.liquid_channel).contentEquals(mName.getText())) {
+                    String author = Liquid.author(video);
+                    if (!TextUtils.isEmpty(author)) {
+                        mName.setText(author);
+                    }
+                }
+
+                checkSubscription(video);
+            }
+
+            mRowsView.requestFocus();
+        }
+    }
+
+    /**
+     * L'état d'abonnement vient des infos d'une vidéo de la chaîne (avec l'avatar au passage).
+     */
+    private void checkSubscription(Video video) {
+        if (mSubscriptionChecked || !Liquid.isPlayable(video)) {
+            return;
+        }
+
+        mSubscriptionChecked = true;
+        mActions.add(Liquid.service().getMediaItemService().getMetadataObserve(video.videoId)
+                .subscribe(metadata -> {
+                    if (metadata == null) {
+                        return;
+                    }
+                    mIsSubscribed = metadata.isSubscribed();
+                    updateSubscribe();
+                    Liquid.loadCircle(this, mAvatar, metadata.getAuthorImageUrl());
+                    if (!TextUtils.isEmpty(metadata.getSubscriberCount())) {
+                        mMeta.setText(metadata.getSubscriberCount());
+                    }
+                }, error -> Log.e(TAG, "Metadata error: %s", error.getMessage())));
+    }
+
+    private void updateSubscribe() {
+        mSubscribe.setText(mIsSubscribed ? R.string.liquid_subscribed : R.string.liquid_subscribe);
+    }
+
+    private void toggleSubscribe() {
+        if (mChannelId == null) {
+            return;
+        }
+
+        mIsSubscribed = !mIsSubscribed;
+        updateSubscribe();
+        mActions.add(RxHelper.execute(mIsSubscribed ?
+                Liquid.service().getMediaItemService().subscribeObserve(mChannelId) :
+                Liquid.service().getMediaItemService().unsubscribeObserve(mChannelId)));
+    }
+
+    private void showMessage(String message) {
+        mMessage.setText(message);
+        mMessage.setVisibility(View.VISIBLE);
+    }
+
+    @Override
+    public void onCardFocused(Video video) {
+        // L'arrière-plan suit la vidéo sélectionnée (avec un petit délai pour rester fluide)
+        mFocusedVideo = video;
+        mBackdrop.removeCallbacks(mBackdropTask);
+        mBackdrop.postDelayed(mBackdropTask, 350);
+    }
+
+    private void updateBackdrop() {
+        if (mFocusedVideo != null) {
+            Liquid.loadBlurred(this, mBackdrop, mFocusedVideo.getCardImageUrl());
+        }
+    }
+
+    @Override
+    public void onCardClicked(Video video) {
+        Liquid.open(this, video);
+    }
+
+    @Override
+    public void onCardLongClicked(Video video) {
+        LiquidVideoMenu.show(this, video, mRowsAdapter::removeVideo);
+    }
+}
