diff --git a/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/util/ModerneStyle.java b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/util/ModerneStyle.java
new file mode 100644
index 0000000..71308b0
--- /dev/null
+++ b/smarttubetv/src/main/java/com/liskovsoft/smartyoutubetv2/tv/util/ModerneStyle.java
@@ -0,0 +1,177 @@
+package com.liskovsoft.smartyoutubetv2.tv.util;
+
+import android.annotation.TargetApi;
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.LinearGradient;
+import android.graphics.Outline;
+import android.graphics.Paint;
+import android.graphics.Shader;
+import android.graphics.drawable.ColorDrawable;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.StateListDrawable;
+import android.os.Build.VERSION;
+import android.util.TypedValue;
+import android.view.View;
+import android.view.ViewOutlineProvider;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+
+/**
+ * Thème « Moderne » (style Apple TV) : outils partagés.
+ */
+public final class ModerneStyle {
+    private ModerneStyle() {
+    }
+
+    /**
+     * Le thème actif est-il le thème Moderne ?
+     */
+    public static boolean isEnabled(Context context) {
+        if (context == null) {
+            return false;
+        }
+
+        TypedValue value = new TypedValue();
+        return context.getTheme().resolveAttribute(R.attr.moderneStyle, value, true)
+                && value.type == TypedValue.TYPE_INT_BOOLEAN && value.data != 0;
+    }
+
+    public static int dp(Context context, float dp) {
+        return Math.round(dp * context.getResources().getDisplayMetrics().density);
+    }
+
+    /**
+     * Coins arrondis sur une vue (image de la vignette).
+     */
+    public static void roundCorners(View view, final float radiusPx) {
+        if (view == null || VERSION.SDK_INT < 21) {
+            return;
+        }
+
+        roundCorners21(view, radiusPx);
+    }
+
+    @TargetApi(21)
+    private static void roundCorners21(View view, final float radiusPx) {
+        view.setOutlineProvider(new ViewOutlineProvider() {
+            @Override
+            public void getOutline(View v, Outline outline) {
+                outline.setRoundRect(0, 0, v.getWidth(), v.getHeight(), radiusPx);
+            }
+        });
+        view.setClipToOutline(true);
+    }
+
+    /**
+     * Pastille arrondie qui n'apparaît que quand l'élément a le focus.
+     */
+    public static Drawable focusPill(Context context, int color, float radiusDp) {
+        GradientDrawable pill = new GradientDrawable();
+        pill.setColor(color);
+        pill.setCornerRadius(dp(context, radiusDp));
+
+        StateListDrawable states = new StateListDrawable();
+        states.addState(new int[] {android.R.attr.state_focused}, pill);
+        states.addState(new int[] {android.R.attr.state_pressed}, pill);
+        states.addState(new int[] {}, new ColorDrawable(0x00000000));
+        return states;
+    }
+
+    /**
+     * Fond « Apple TV » : la miniature très floutée et assombrie.
+     * Le bitmap d'entrée est petit (~160x90), donc le flou est rapide.
+     */
+    public static Bitmap blurredBackdrop(Bitmap source) {
+        if (source == null || source.getWidth() <= 0 || source.getHeight() <= 0) {
+            return null;
+        }
+
+        int width = 160;
+        int height = 90;
+        Bitmap small = Bitmap.createScaledBitmap(source, width, height, true);
+        if (small.getConfig() != Bitmap.Config.ARGB_8888) {
+            small = small.copy(Bitmap.Config.ARGB_8888, false);
+        }
+
+        int[] pixels = new int[width * height];
+        small.getPixels(pixels, 0, width, 0, 0, width, height);
+
+        // Trois passes de flou boîte ≈ flou gaussien
+        for (int i = 0; i < 3; i++) {
+            boxBlurHorizontal(pixels, width, height, 6);
+            boxBlurVertical(pixels, width, height, 6);
+        }
+
+        Bitmap result = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888);
+        result.setPixels(pixels, 0, width, 0, 0, width, height);
+
+        // Assombrir, plus fort en bas (là où sont les vignettes)
+        Canvas canvas = new Canvas(result);
+        Paint dim = new Paint();
+        dim.setColor(0x73000000);
+        canvas.drawRect(0, 0, width, height, dim);
+
+        Paint gradient = new Paint();
+        gradient.setShader(new LinearGradient(0, 0, 0, height,
+                new int[] {0x00000000, 0x40000000, 0xB3000000},
+                new float[] {0f, 0.45f, 1f}, Shader.TileMode.CLAMP));
+        canvas.drawRect(0, 0, width, height, gradient);
+
+        return result;
+    }
+
+    private static void boxBlurHorizontal(int[] px, int w, int h, int r) {
+        int[] row = new int[w];
+        for (int y = 0; y < h; y++) {
+            int offset = y * w;
+            int sr = 0, sg = 0, sb = 0;
+            for (int i = -r; i <= r; i++) {
+                int c = px[offset + clamp(i, 0, w - 1)];
+                sr += (c >> 16) & 0xFF;
+                sg += (c >> 8) & 0xFF;
+                sb += c & 0xFF;
+            }
+            int div = r * 2 + 1;
+            for (int x = 0; x < w; x++) {
+                row[x] = 0xFF000000 | ((sr / div) << 16) | ((sg / div) << 8) | (sb / div);
+                int out = px[offset + clamp(x - r, 0, w - 1)];
+                int in = px[offset + clamp(x + r + 1, 0, w - 1)];
+                sr += ((in >> 16) & 0xFF) - ((out >> 16) & 0xFF);
+                sg += ((in >> 8) & 0xFF) - ((out >> 8) & 0xFF);
+                sb += (in & 0xFF) - (out & 0xFF);
+            }
+            System.arraycopy(row, 0, px, offset, w);
+        }
+    }
+
+    private static void boxBlurVertical(int[] px, int w, int h, int r) {
+        int[] col = new int[h];
+        for (int x = 0; x < w; x++) {
+            int sr = 0, sg = 0, sb = 0;
+            for (int i = -r; i <= r; i++) {
+                int c = px[clamp(i, 0, h - 1) * w + x];
+                sr += (c >> 16) & 0xFF;
+                sg += (c >> 8) & 0xFF;
+                sb += c & 0xFF;
+            }
+            int div = r * 2 + 1;
+            for (int y = 0; y < h; y++) {
+                col[y] = 0xFF000000 | ((sr / div) << 16) | ((sg / div) << 8) | (sb / div);
+                int out = px[clamp(y - r, 0, h - 1) * w + x];
+                int in = px[clamp(y + r + 1, 0, h - 1) * w + x];
+                sr += ((in >> 16) & 0xFF) - ((out >> 16) & 0xFF);
+                sg += ((in >> 8) & 0xFF) - ((out >> 8) & 0xFF);
+                sb += (in & 0xFF) - (out & 0xFF);
+            }
+            for (int y = 0; y < h; y++) {
+                px[y * w + x] = col[y];
+            }
+        }
+    }
+
+    private static int clamp(int v, int min, int max) {
+        return v < min ? min : (v > max ? max : v);
+    }
+}
