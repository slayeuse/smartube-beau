+package com.liskovsoft.smartyoutubetv2.tv.ui.liquid;
+
+import android.app.Activity;
+import android.text.TextUtils;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.TextView;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.leanback.widget.HorizontalGridView;
+import androidx.recyclerview.widget.RecyclerView;
+import com.liskovsoft.mediaserviceinterfaces.data.MediaGroup;
+import com.liskovsoft.sharedutils.mylogger.Log;
+import com.liskovsoft.sharedutils.rx.RxHelper;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.VideoGroup;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+import io.reactivex.disposables.Disposable;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Liquid Glass : rangées de vignettes (titre + défilement horizontal infini).
+ */
+public class LiquidRowAdapter extends RecyclerView.Adapter<LiquidRowAdapter.RowHolder> {
+    private static final String TAG = LiquidRowAdapter.class.getSimpleName();
+
+    public static class Row {
+        public final String title;
+        public final List<Video> videos;
+        /**
+         * Groupe YouTube d'origine : sert à charger la suite de la rangée (null = pas de suite)
+         */
+        @Nullable
+        MediaGroup group;
+        boolean loading;
+        @Nullable
+        LiquidCardAdapter adapter;
+
+        public Row(String title, List<Video> videos) {
+            this(title, videos, null);
+        }
+
+        public Row(String title, List<Video> videos, @Nullable MediaGroup group) {
+            this.title = title;
+            this.videos = videos != null ? videos : new ArrayList<>();
+            this.group = group;
+        }
+    }
+
+    private final Activity mActivity;
+    private final LiquidCardAdapter.Listener mListener;
+    private final List<Row> mRows = new ArrayList<>();
+    private final List<Disposable> mActions = new ArrayList<>();
+
+    public LiquidRowAdapter(Activity activity, LiquidCardAdapter.Listener listener) {
+        mActivity = activity;
+        mListener = listener;
+    }
+
+    public static List<Video> toVideos(MediaGroup group) {
+        List<Video> result = new ArrayList<>();
+
+        if (group == null) {
+            return result;
+        }
+
+        VideoGroup videoGroup = VideoGroup.from(group);
+
+        if (videoGroup != null && videoGroup.getVideos() != null) {
+            result.addAll(videoGroup.getVideos());
+        }
+
+        return result;
+    }
+
+    @NonNull
+    @Override
+    public RowHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+        View view = LayoutInflater.from(parent.getContext()).inflate(R.layout.liquid_row, parent, false);
+        return new RowHolder(view);
+    }
+
+    @Override
+    public void onBindViewHolder(@NonNull RowHolder holder, int position) {
+        final Row row = mRows.get(position);
+        holder.title.setText(row.title);
+        holder.title.setVisibility(TextUtils.isEmpty(row.title) ? View.GONE : View.VISIBLE);
+        row.adapter = new LiquidCardAdapter(mActivity, row.videos, mListener, () -> continueRow(row));
+        holder.cards.setAdapter(row.adapter);
+    }
+
+    @Override
+    public int getItemCount() {
+        return mRows.size();
+    }
+
+    public List<Row> getRows() {
+        return mRows;
+    }
+
+    public void addRow(Row row) {
+        if (row == null || row.videos.isEmpty()) {
+            return;
+        }
+
+        mRows.add(row);
+        notifyItemInserted(mRows.size() - 1);
+    }
+
+    public void clear() {
+        RxHelper.disposeActions(mActions);
+        mActions.clear();
+        mRows.clear();
+        notifyDataSetChanged();
+    }
+
+    /**
+     * Charge la suite d'une rangée quand on arrive au bout.
+     */
+    private void continueRow(final Row row) {
+        if (row.loading || row.group == null || row.group.getNextPageKey() == null || !Liquid.isAlive(mActivity)) {
+            return;
+        }
+
+        row.loading = true;
+        mActions.add(Liquid.service().getContentService().continueGroupObserve(row.group)
+                .subscribe(next -> {
+                    row.loading = false;
+                    row.group = next;
+                    List<Video> more = toVideos(next);
+
+                    if (more.isEmpty()) {
+                        row.group = null; // plus rien à charger
+                        return;
+                    }
+
+                    int start = row.videos.size();
+                    row.videos.addAll(more);
+
+                    if (row.adapter != null) {
+                        row.adapter.notifyAppended(start, more.size());
+                    }
+                }, error -> {
+                    row.loading = false;
+                    row.group = null;
+                    Log.e(TAG, "Row continuation error: %s", error.getMessage());
+                }, () -> row.loading = false));
+    }
+
+    static class RowHolder extends RecyclerView.ViewHolder {
+        final TextView title;
+        final HorizontalGridView cards;
+
+        RowHolder(View view) {
+            super(view);
+            title = view.findViewById(R.id.row_title);
+            cards = view.findViewById(R.id.row_cards);
+            cards.setHorizontalSpacing(Liquid.dp(view.getContext(), 18));
+            // La vignette sélectionnée reste vers la gauche, comme sur Apple TV
+            cards.setWindowAlignment(HorizontalGridView.WINDOW_ALIGN_LOW_EDGE);
+            cards.setWindowAlignmentOffsetPercent(0);
+            cards.setWindowAlignmentOffset(Liquid.dp(view.getContext(), 48));
+            cards.setItemAlignmentOffsetPercent(0);
+        }
+    }
+}
