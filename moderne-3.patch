+package com.liskovsoft.smartyoutubetv2.tv.ui.liquid;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.Log;
+
+/**
+ * Liquid Glass : garde la dernière erreur de l'appli pour l'afficher à l'écran
+ * au lancement suivant (on peut alors la prendre en photo pour la corriger).
+ */
+public final class LiquidCrash {
+    private static final String PREFS = "liquid_glass";
+    private static final String KEY_CRASH = "last_crash";
+
+    private LiquidCrash() {
+    }
+
+    public static void save(Context context, Throwable error) {
+        if (context == null || error == null) {
+            return;
+        }
+
+        try {
+            String trace = Log.getStackTraceString(error);
+
+            if (trace.length() > 1500) {
+                trace = trace.substring(0, 1500);
+            }
+
+            prefs(context).edit().putString(KEY_CRASH, trace).commit();
+        } catch (Throwable ignored) {
+            // ne jamais planter pendant qu'on enregistre un plantage
+        }
+    }
+
+    /**
+     * @return la dernière erreur, ou null. L'erreur est effacée après lecture.
+     */
+    public static String pop(Context context) {
+        try {
+            SharedPreferences prefs = prefs(context);
+            String trace = prefs.getString(KEY_CRASH, null);
+
+            if (trace != null) {
+                prefs.edit().remove(KEY_CRASH).apply();
+            }
+
+            return trace;
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    public static boolean isLiquidCrash(String trace) {
+        return trace != null && trace.contains(".ui.liquid.");
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return context.getApplicationContext().getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+}
