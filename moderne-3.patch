@@ -0,0 +1,184 @@
+package com.liskovsoft.smartyoutubetv2.tv.ui.liquid;
+
+import android.app.Activity;
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.os.Build.VERSION;
+import android.text.TextUtils;
+import android.view.View;
+import android.widget.ImageView;
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import com.bumptech.glide.Glide;
+import com.bumptech.glide.request.target.SimpleTarget;
+import com.bumptech.glide.request.transition.Transition;
+import com.liskovsoft.mediaserviceinterfaces.ServiceManager;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+import com.liskovsoft.smartyoutubetv2.common.app.presenters.dialogs.VideoActionPresenter;
+import com.liskovsoft.smartyoutubetv2.tv.util.ModerneStyle;
+import com.liskovsoft.youtubeapi.service.YouTubeServiceManager;
+
+/**
+ * Liquid Glass : outils communs aux nouveaux écrans.
+ */
+public final class Liquid {
+    private Liquid() {
+    }
+
+    public static ServiceManager service() {
+        return YouTubeServiceManager.instance();
+    }
+
+    public static int dp(Context context, float value) {
+        return Math.round(value * context.getResources().getDisplayMetrics().density);
+    }
+
+    public static boolean isAlive(Activity activity) {
+        return activity != null && !activity.isFinishing() && !activity.isDestroyed();
+    }
+
+    /**
+     * Lecture, chaîne ou playlist : le moteur de SmartTube s'occupe de tout.
+     */
+    public static void open(Activity activity, Video video) {
+        if (video != null && isAlive(activity)) {
+            VideoActionPresenter.instance(activity).apply(video);
+        }
+    }
+
+    public static boolean isPlayable(Video video) {
+        return video != null && !TextUtils.isEmpty(video.videoId);
+    }
+
+    /**
+     * Grande image de la vidéo (pour les fonds), avec la miniature normale en secours.
+     */
+    @Nullable
+    public static String bigImageUrl(Video video) {
+        if (video == null) {
+            return null;
+        }
+
+        if (!TextUtils.isEmpty(video.videoId)) {
+            return "https://i.ytimg.com/vi/" + video.videoId + "/maxresdefault.jpg";
+        }
+
+        return video.getCardImageUrl();
+    }
+
+    public static CharSequence meta(Video video) {
+        if (video == null) {
+            return "";
+        }
+
+        CharSequence second = video.getSecondTitle();
+
+        if (!TextUtils.isEmpty(second)) {
+            return second;
+        }
+
+        return video.getAuthor() != null ? video.getAuthor() : "";
+    }
+
+    public static String author(Video video) {
+        if (video == null) {
+            return "";
+        }
+
+        if (!TextUtils.isEmpty(video.getAuthor())) {
+            return video.getAuthor();
+        }
+
+        CharSequence second = video.getSecondTitle();
+
+        if (TextUtils.isEmpty(second)) {
+            return "";
+        }
+
+        String text = second.toString();
+        int separator = text.indexOf('•');
+        return separator > 0 ? text.substring(0, separator).trim() : text;
+    }
+
+    public static void loadImage(Activity activity, ImageView target, String url, @Nullable String fallbackUrl) {
+        if (!isAlive(activity) || target == null) {
+            return;
+        }
+
+        if (TextUtils.isEmpty(url)) {
+            url = fallbackUrl;
+        }
+
+        if (TextUtils.isEmpty(url)) {
+            target.setImageDrawable(null);
+            return;
+        }
+
+        if (!TextUtils.isEmpty(fallbackUrl) && !fallbackUrl.equals(url)) {
+            Glide.with(activity)
+                    .load(url)
+                    .error(Glide.with(activity).load(fallbackUrl))
+                    .into(target);
+        } else {
+            Glide.with(activity)
+                    .load(url)
+                    .into(target);
+        }
+    }
+
+    public static void loadCircle(Activity activity, ImageView target, String url) {
+        if (!isAlive(activity) || target == null || TextUtils.isEmpty(url)) {
+            return;
+        }
+
+        Glide.with(activity)
+                .load(url)
+                .circleCrop()
+                .into(target);
+    }
+
+    /**
+     * Fond flouté et assombri, comme sur Apple TV.
+     */
+    public static void loadBlurred(final Activity activity, final ImageView target, String url) {
+        if (!isAlive(activity) || target == null || TextUtils.isEmpty(url)) {
+            return;
+        }
+
+        Glide.with(activity)
+                .asBitmap()
+                .load(url)
+                .into(new SimpleTarget<Bitmap>(320, 180) {
+                    @Override
+                    public void onResourceReady(@NonNull Bitmap resource, @Nullable Transition<? super Bitmap> transition) {
+                        if (!isAlive(activity)) {
+                            return;
+                        }
+
+                        Bitmap blurred = ModerneStyle.blurredBackdrop(resource);
+
+                        if (blurred != null) {
+                            target.setImageBitmap(blurred);
+                        }
+                    }
+                });
+    }
+
+    /**
+     * Effet de focus : la vue grossit et passe au premier plan.
+     */
+    public static void bindFocusScale(View view, final float scale, @Nullable final View.OnFocusChangeListener extra) {
+        view.setOnFocusChangeListener((v, hasFocus) -> {
+            float target = hasFocus ? scale : 1f;
+            v.animate().scaleX(target).scaleY(target).setDuration(150).start();
+
+            if (VERSION.SDK_INT >= 21) {
+                v.setTranslationZ(hasFocus ? dp(v.getContext(), 8) : 0);
+            }
+
+            if (extra != null) {
+                extra.onFocusChange(v, hasFocus);
+            }
+        });
+    }
+}
