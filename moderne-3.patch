+ * Barre d'onglets en verre, grand visuel de la vidéo sélectionnée, rangées de vignettes.
+ */
+public class LiquidHomeActivity extends LeanbackActivity implements LiquidCardAdapter.Listener {
+    private static final String TAG = LiquidHomeActivity.class.getSimpleName();
+    private static final int TAB_HOME = 0;
+    private static final int TAB_SUBSCRIPTIONS = 1;
+    private static final int TAB_SHORTS = 2;
+    private static final int TAB_LIBRARY = 3;
+    private static final int GRID_ROW_SIZE = 5;
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final List<Disposable> mActions = new ArrayList<>();
+    private final Runnable mClockTask = this::updateClock;
+    private final Runnable mHeroTask = this::updateHero;
+
+    private ImageView mBackdrop;
+    private TextView mHeroChannel;
+    private TextView mHeroTitle;
+    private TextView mHeroMeta;
+    private View mHeroInfo;
+    private TextView mMessage;
+    private ProgressBar mLoading;
+    private TextView mClock;
+    private ImageView mAvatar;
+    private TextView[] mTabs;
+    private VerticalGridView mRowsView;
+    private LiquidRowAdapter mRowsAdapter;
+
+    private int mCurrentTab = TAB_HOME;
+    private Video mFocusedVideo;
+    private Video mHeroVideo;
+    private String mLoadedAccount;
+    private MediaGroup mGridGroup; // onglet en grille (abonnements, shorts) : pour charger la suite
+    private Disposable mContinueAction;
+    private List<Video> mPendingGridVideos = new ArrayList<>();
+    private boolean mFocusContentOnLoad = true;
+    private boolean mInitialized;
+
+    @Override
+    protected void initTheme() {
+        setTheme(R.style.App_Theme_Liquid);
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        // Erreur au lancement précédent : on l'affiche pour pouvoir la corriger
+        String lastCrash = LiquidCrash.pop(this);
+        if (lastCrash != null) {
+            MessageHelpers.showLongMessage(this, "Dernière erreur : " + lastCrash);
+        }
+
+        try {
+            initViews();
+        } catch (Throwable e) {
+            // Le nouvel accueil n'a pas pu s'afficher : on montre l'erreur et on ouvre l'ancien accueil
+            Log.e(TAG, "Liquid home error: %s", e.getMessage());
+            MessageHelpers.showLongMessage(this, "Erreur Liquid : " + android.util.Log.getStackTraceString(e));
+            Intent classic = new Intent(this, com.liskovsoft.smartyoutubetv2.tv.ui.browse.BrowseActivity.class);
+            classic.putExtra(com.liskovsoft.smartyoutubetv2.tv.ui.browse.BrowseActivity.EXTRA_CLASSIC, true);
+            startActivity(classic);
+            finishReally();
+        }
+    }
+
+    private void initViews() {
+        setContentView(R.layout.liquid_home);
+
+        LiquidSetup.init(getApplicationContext());
+
+        mBackdrop = findViewById(R.id.hero_backdrop);
+        mHeroChannel = findViewById(R.id.hero_channel);
+        mHeroTitle = findViewById(R.id.hero_title);
+        mHeroMeta = findViewById(R.id.hero_meta);
+        mHeroInfo = findViewById(R.id.hero_info);
+        mMessage = findViewById(R.id.liquid_message);
+        mLoading = findViewById(R.id.liquid_loading);
+        mClock = findViewById(R.id.liquid_clock);
+        mAvatar = findViewById(R.id.nav_avatar);
+        mRowsView = findViewById(R.id.liquid_rows);
+
+        mTabs = new TextView[] {
+                findViewById(R.id.tab_home),
+                findViewById(R.id.tab_subscriptions),
+                findViewById(R.id.tab_shorts),
+                findViewById(R.id.tab_library)
+        };
+
+        for (int i = 0; i < mTabs.length; i++) {
+            final int tab = i;
+            mTabs[i].setOnClickListener(v -> selectTab(tab));
+        }
+
+        findViewById(R.id.nav_search).setOnClickListener(v -> startActivity(new Intent(this, LiquidSearchActivity.class)));
+        mAvatar.setOnClickListener(v -> startActivity(new Intent(this, LiquidAccountActivity.class)));
+
+        findViewById(R.id.hero_play).setOnClickListener(v -> Liquid.open(this, mHeroVideo));
+        findViewById(R.id.hero_details).setOnClickListener(v -> {
+            if (Liquid.isPlayable(mHeroVideo)) {
+                LiquidDetailsActivity.start(this, mHeroVideo, false);
+            }
+        });
+
+        mRowsAdapter = new LiquidRowAdapter(this, this);
+        mRowsView.setAdapter(mRowsAdapter);
+        mRowsView.setVerticalSpacing(Liquid.dp(this, 6));
+        mRowsView.setWindowAlignment(BaseGridView.WINDOW_ALIGN_LOW_EDGE);
+        mRowsView.setWindowAlignmentOffsetPercent(0);
+        mRowsView.setWindowAlignmentOffset(0);
+        mRowsView.setItemAlignmentOffsetPercent(0);
+        mRowsView.setOnChildViewHolderSelectedListener(new OnChildViewHolderSelectedListener() {
+            @Override
+            public void onChildViewHolderSelected(RecyclerView parent, RecyclerView.ViewHolder child, int position, int subposition) {
+                if (position >= mRowsAdapter.getItemCount() - 2) {
+                    continueGrid();
+                }
+            }
+        });
+
+        updateTabsState();
+        loadTab(TAB_HOME);
+        mInitialized = true;
+    }
+
+    @Override
+    protected void onResume() {
+        super.onResume();
+
+        if (!mInitialized) {
+            return;
+        }
+
+        updateClock();
+        updateAvatar();
+
+        // Compte changé (connexion, changement de compte) : on recharge
+        String account = getAccountKey();
+        if (!TextUtils.equals(account, mLoadedAccount)) {
+            loadTab(mCurrentTab);
+        }
+    }
+
+    @Override
+    protected void onPause() {
+        super.onPause();
+        mHandler.removeCallbacks(mClockTask);
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        mHandler.removeCallbacksAndMessages(null);
+        disposeAll();
+    }
+
+    @Override
+    public boolean onSearchRequested() {
+        startActivity(new Intent(this, LiquidSearchActivity.class));
+        return true;
+    }
+
+    @Override
+    public boolean onKeyDown(int keyCode, KeyEvent event) {
+        // Touche menu : page vidéo avec description et commentaires
+        if (keyCode == KeyEvent.KEYCODE_MENU && Liquid.isPlayable(mFocusedVideo)) {
+            LiquidDetailsActivity.start(this, mFocusedVideo, false);
+            return true;
+        }
+
+        return super.onKeyDown(keyCode, event);
+    }
+
+    // ----- Vignettes -----
+
+    @Override
+    public void onCardFocused(Video video) {
+        mFocusedVideo = video;
+        mHandler.removeCallbacks(mHeroTask);
+        mHandler.postDelayed(mHeroTask, 250);
+    }
+
+    @Override
+    public void onCardClicked(Video video) {
+        Liquid.open(this, video);
+    }
+
+    @Override
+    public void onCardLongClicked(Video video) {
+        if (Liquid.isPlayable(video)) {
+            LiquidDetailsActivity.start(this, video, false);
+        } else {
+            Liquid.open(this, video);
+        }
+    }
+
+    private void updateHero() {
+        Video video = mFocusedVideo;
+
+        if (video == null || video == mHeroVideo) {
+            return;
+        }
+
+        mHeroVideo = video;
+        mHeroInfo.setVisibility(View.VISIBLE);
+        mHeroChannel.setText(Liquid.author(video));
+        mHeroTitle.setText(video.getTitle());
+        mHeroMeta.setText(Liquid.meta(video));
+        Liquid.loadImage(this, mBackdrop, Liquid.bigImageUrl(video), video.getCardImageUrl());
+    }
+
+    // ----- Onglets -----
+
+    private void selectTab(int tab) {
+        if (tab == mCurrentTab && mRowsAdapter.getItemCount() > 0) {
+            mRowsView.requestFocus();
+            return;
+        }
+
+        mCurrentTab = tab;
+        updateTabsState();
+        loadTab(tab);
+    }
+
+    private void updateTabsState() {
+        for (int i = 0; i < mTabs.length; i++) {
+            mTabs[i].setActivated(i == mCurrentTab);
+        }
+    }
+
+    private void loadTab(int tab) {
+        disposeAll();
+        mRowsAdapter.clear();
+        mGridGroup = null;
+        mPendingGridVideos = new ArrayList<>();
+        mFocusedVideo = null;
+        mLoadedAccount = getAccountKey();
+        showMessage(null);
+        showLoading(true);
+
+        ContentService content = Liquid.service().getContentService();
+        boolean signed = isSigned();
+
+        switch (tab) {
+            case TAB_HOME:
+                mActions.add(content.getHomeObserve().subscribe(this::addGroups, this::onLoadError, this::onLoadFinished));
+                break;
+            case TAB_SUBSCRIPTIONS:
+                if (!signed) {
+                    onSignInNeeded();
+                    return;
+                }
+                mActions.add(content.getSubscriptionsObserve().subscribe(this::addGridGroup, this::onLoadError, this::onLoadFinished));
+                break;
+            case TAB_SHORTS:
+                mActions.add(content.getShortsObserve().subscribe(this::addGridGroup, this::onLoadError, this::onLoadFinished));
+                break;
+            case TAB_LIBRARY:
+                if (!signed) {
+                    onSignInNeeded();
+                    return;
+                }
+                mActions.add(content.getHistoryObserve().subscribe(group -> addGroup(group, getString(R.string.liquid_history)),
+                        this::onLoadError, () -> mActions.add(content.getPlaylistRowsObserve().subscribe(this::addGroups, this::onLoadError, this::onLoadFinished))));
+                break;
+        }
+    }
+
+    private void addGroups(List<MediaGroup> groups) {
+        if (groups == null) {
+            return;
+        }
+
+        for (MediaGroup group : groups) {
+            addGroup(group, null);
+        }
+    }
+
+    private void addGroup(MediaGroup group, String forcedTitle) {
+        if (group == null || group.isEmpty()) {
+            return;
+        }
+
+        List<Video> videos = toVideos(group);
+
+        if (videos.isEmpty()) {
+            return;
+        }
+
+        String title = forcedTitle != null ? forcedTitle : group.getTitle();
+        mRowsAdapter.addRow(new LiquidRowAdapter.Row(title, videos, group));
+        onFirstContent();
+    }
+
+    /**
+     * Onglet en grille (abonnements, shorts) : découpé en rangées de 5.
+     */
+    private void addGridGroup(MediaGroup group) {
+        if (group == null) {
+            return;
+        }
+
+        mGridGroup = group;
+        boolean first = mRowsAdapter.getItemCount() == 0 && mPendingGridVideos.isEmpty();
+        List<Video> videos = new ArrayList<>(mPendingGridVideos);
+        videos.addAll(toVideos(group));
+        mPendingGridVideos = new ArrayList<>();
+
+        int index = 0;
+        while (videos.size() - index >= GRID_ROW_SIZE) {
+            String title = first && index == 0 ? mTabs[mCurrentTab].getText().toString() : null;
+            mRowsAdapter.addRow(new LiquidRowAdapter.Row(title, new ArrayList<>(videos.subList(index, index + GRID_ROW_SIZE))));
+            index += GRID_ROW_SIZE;
+        }
+
+        if (index < videos.size()) {
+            List<Video> rest = new ArrayList<>(videos.subList(index, videos.size()));
+
+            if (group.getNextPageKey() == null) {
+                String title = first && index == 0 ? mTabs[mCurrentTab].getText().toString() : null;
+                mRowsAdapter.addRow(new LiquidRowAdapter.Row(title, rest));
+            } else {
+                mPendingGridVideos = rest;
+            }
+        }
+
+        onFirstContent();
+    }
+
+    private void continueGrid() {
+        if (mGridGroup == null || mGridGroup.getNextPageKey() == null || RxHelper.isAnyActionRunning(mContinueAction)) {
+            return;
+        }
+
+        MediaGroup current = mGridGroup;
+        mGridGroup = null; // évite les doubles chargements
+        mContinueAction = Liquid.service().getContentService().continueGroupObserve(current)
+                .subscribe(this::addGridGroup, error -> Log.e(TAG, "Continue error: %s", error.getMessage()));
+    }
+
+    private static List<Video> toVideos(MediaGroup group) {
+        List<Video> result = new ArrayList<>();
+        VideoGroup videoGroup = VideoGroup.from(group);
+
+        if (videoGroup != null && videoGroup.getVideos() != null) {
+            result.addAll(videoGroup.getVideos());
+        }
+
+        return result;
+    }
+
+    private void onFirstContent() {
+        showLoading(false);
+        showMessage(null);
+
+        if (mFocusedVideo == null && mRowsAdapter.getItemCount() > 0) {
+            List<Video> first = mRowsAdapter.getRows().get(0).videos;
+            if (!first.isEmpty()) {
+                mFocusedVideo = first.get(0);
+                updateHero();
+            }
+        }
+
+        // Au lancement, la télécommande arrive directement sur les vignettes
+        if (mFocusContentOnLoad && mRowsAdapter.getItemCount() > 0) {
+            mFocusContentOnLoad = false;
+            mRowsView.requestFocus();
+        }
+    }
+
+    private void onLoadFinished() {
+        showLoading(false);
+
+        if (mRowsAdapter.getItemCount() == 0) {
+            showMessage(getString(R.string.liquid_empty));
+        }
+    }
+
+    private void onLoadError(Throwable error) {
+        Log.e(TAG, "Load error: %s", error.getMessage());
+        showLoading(false);
+
+        if (mRowsAdapter.getItemCount() == 0) {
+            showMessage(getString(R.string.liquid_loading_error));
+        }
+    }
+
+    private void onSignInNeeded() {
+        showLoading(false);
+        showMessage(getString(R.string.liquid_sign_in_needed));
+        mAvatar.requestFocus();
+    }
+
+    private void showLoading(boolean show) {
+        mLoading.setVisibility(show ? View.VISIBLE : View.GONE);
+    }
+
+    private void showMessage(String message) {
+        mMessage.setText(message);
+        mMessage.setVisibility(message != null ? View.VISIBLE : View.GONE);
+    }
+
+    private void disposeAll() {
+        RxHelper.disposeActions(mActions);
+        mActions.clear();
+        RxHelper.disposeActions(mContinueAction);
+    }
+
+    // ----- Compte et horloge -----
+
+    private boolean isSigned() {
+        try {
+            return Liquid.service().getSignInService().isSigned();
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    private String getAccountKey() {
+        try {
+            SignInService signIn = Liquid.service().getSignInService();
+            Account account = signIn.getSelectedAccount();
+            return account != null ? account.getName() + "|" + account.getEmail() : "";
+        } catch (RuntimeException e) {
+            return "";
+        }
+    }
+
+    private void updateAvatar() {
+        try {
+            Account account = Liquid.service().getSignInService().getSelectedAccount();
+
+            if (account != null && !TextUtils.isEmpty(account.getAvatarImageUrl())) {
+                Liquid.loadCircle(this, mAvatar, account.getAvatarImageUrl());
+            } else {
+                mAvatar.setImageResource(R.drawable.liquid_avatar_placeholder);
+            }
+        } catch (RuntimeException e) {
+            mAvatar.setImageResource(R.drawable.liquid_avatar_placeholder);
+        }
+    }
+
+    private void updateClock() {
+        mClock.setText(DateFormat.getTimeFormat(this).format(new Date()));
+        mHandler.removeCallbacks(mClockTask);
+        mHandler.postDelayed(mClockTask, 30_000);
+    }
+}
