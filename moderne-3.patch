+        /**
+         * Liquid Glass : le rond devient blanc au focus (voir lb_control_button_primary.xml),
+         * l'icône passe alors en sombre pour rester lisible.
+         */
+        private static void applyModerneStyle(final ActionViewHolder vh) {
+            if (vh.mFocusableView == null || vh.mIcon == null) {
+                return;
+            }
+
+            final android.view.ViewTreeObserver.OnGlobalFocusChangeListener focusListener = (oldFocus, newFocus) -> {
+                if (newFocus == vh.mFocusableView) {
+                    vh.mIcon.setColorFilter(0xFF1C1C1E, android.graphics.PorterDuff.Mode.SRC_IN);
+                } else if (oldFocus == vh.mFocusableView) {
+                    vh.mIcon.clearColorFilter();
+                }
+            };
+
+            vh.view.addOnAttachStateChangeListener(new View.OnAttachStateChangeListener() {
+                @Override
+                public void onViewAttachedToWindow(View view) {
+                    view.getViewTreeObserver().addOnGlobalFocusChangeListener(focusListener);
+                }
+
+                @Override
+                public void onViewDetachedFromWindow(View view) {
+                    view.getViewTreeObserver().removeOnGlobalFocusChangeListener(focusListener);
+                    vh.mIcon.clearColorFilter();
+                }
+            });
         }
 
