diff --git a/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/misc/LiquidHooks.java b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/misc/LiquidHooks.java
new file mode 100644
index 0000000..78bc712
--- /dev/null
+++ b/common/src/main/java/com/liskovsoft/smartyoutubetv2/common/misc/LiquidHooks.java
@@ -0,0 +1,62 @@
+package com.liskovsoft.smartyoutubetv2.common.misc;
+
+import android.content.Context;
+import com.liskovsoft.smartyoutubetv2.common.app.models.data.Video;
+
+/**
+ * Liquid Glass : permet au module "common" d'ouvrir les nouveaux écrans
+ * (page vidéo avec description et commentaires) sans en dépendre.
+ */
+public final class LiquidHooks {
+    public interface DetailsOpener {
+        /**
+         * @return true si l'écran Liquid a été ouvert
+         */
+        boolean openDetails(Context context, Video video, boolean focusComments);
+    }
+
+    public interface ChannelOpener {
+        /**
+         * @return true si la page de chaîne Liquid a été ouverte
+         */
+        boolean openChannel(Context context, String channelId, Video video);
+    }
+
+    private static DetailsOpener sDetailsOpener;
+    private static ChannelOpener sChannelOpener;
+
+    private LiquidHooks() {
+    }
+
+    public static void setDetailsOpener(DetailsOpener opener) {
+        sDetailsOpener = opener;
+    }
+
+    public static void setChannelOpener(ChannelOpener opener) {
+        sChannelOpener = opener;
+    }
+
+    public static boolean openChannel(Context context, String channelId, Video video) {
+        if (sChannelOpener == null || context == null || channelId == null) {
+            return false;
+        }
+
+        try {
+            return sChannelOpener.openChannel(context, channelId, video);
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+
+    public static boolean openDetails(Context context, Video video, boolean focusComments) {
+        if (sDetailsOpener == null || context == null || video == null || video.videoId == null) {
+            return false;
+        }
+
+        try {
+            return sDetailsOpener.openDetails(context, video, focusComments);
+        } catch (RuntimeException e) {
+            return false;
+        }
+    }
+}
