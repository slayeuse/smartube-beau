+package com.liskovsoft.smartyoutubetv2.tv.ui.liquid;
+
+import android.content.Intent;
+import android.os.Bundle;
+import android.text.TextUtils;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextView;
+import com.liskovsoft.mediaserviceinterfaces.SignInService;
+import com.liskovsoft.mediaserviceinterfaces.oauth.Account;
+import com.liskovsoft.sharedutils.mylogger.Log;
+import com.liskovsoft.sharedutils.rx.RxHelper;
+import com.liskovsoft.smartyoutubetv2.tv.R;
+import com.liskovsoft.smartyoutubetv2.tv.ui.browse.BrowseActivity;
+import com.liskovsoft.smartyoutubetv2.tv.ui.common.LeanbackActivity;
+import io.reactivex.disposables.Disposable;
+
+import java.util.List;
+
+/**
+ * Liquid Glass : compte YouTube (connexion par code, choix du compte, réglages avancés).
+ */
+public class LiquidAccountActivity extends LeanbackActivity {
+    private static final String TAG = LiquidAccountActivity.class.getSimpleName();
+
+    private Disposable mSignInAction;
+    private TextView mStatus;
+    private View mCodeBox;
+    private TextView mCode;
+    private LinearLayout mList;
+
+    @Override
+    protected void initTheme() {
+        setTheme(R.style.App_Theme_Liquid);
+    }
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        setContentView(R.layout.liquid_account);
+
+        mStatus = findViewById(R.id.account_status);
+        mCodeBox = findViewById(R.id.account_code_box);
+        mCode = findViewById(R.id.account_code);
+        mList = findViewById(R.id.account_list);
+
+        findViewById(R.id.account_add).setOnClickListener(v -> startSignIn());
+        findViewById(R.id.account_settings).setOnClickListener(v -> {
+            Intent intent = new Intent(this, BrowseActivity.class);
+            intent.putExtra(BrowseActivity.EXTRA_CLASSIC, true);
+            startActivity(intent);
+        });
+
+        refreshAccounts();
+        findViewById(R.id.account_add).requestFocus();
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        RxHelper.disposeActions(mSignInAction);
+    }
+
+    private SignInService signIn() {
+        return Liquid.service().getSignInService();
+    }
+
+    private void refreshAccounts() {
+        mList.removeAllViews();
+        List<Account> accounts = null;
+
+        try {
+            accounts = signIn().getAccounts();
+        } catch (RuntimeException e) {
+            Log.e(TAG, "Accounts error: %s", e.getMessage());
+        }
+
+        if (accounts == null || accounts.isEmpty()) {
+            mStatus.setText(R.string.liquid_signed_out);
+            return;
+        }
+
+        mStatus.setText(R.string.liquid_signed_in);
+        Account selected = signIn().getSelectedAccount();
+        LayoutInflater inflater = LayoutInflater.from(this);
+
+        for (final Account account : accounts) {
+            if (account == null || account.isEmpty()) {
+                continue;
+            }
+
+            View item = inflater.inflate(R.layout.liquid_account_item, mList, false);
+            ((TextView) item.findViewById(R.id.account_item_name)).setText(account.getName());
+            ((TextView) item.findViewById(R.id.account_item_email)).setText(account.getEmail());
+
+            boolean isSelected = selected != null && TextUtils.equals(selected.getName(), account.getName())
+                    && TextUtils.equals(selected.getEmail(), account.getEmail());
+            item.findViewById(R.id.account_item_check).setVisibility(isSelected ? View.VISIBLE : View.GONE);
+
+            ImageView avatar = item.findViewById(R.id.account_item_avatar);
+            Liquid.loadCircle(this, avatar, account.getAvatarImageUrl());
+
+            item.setOnClickListener(v -> {
+                signIn().selectAccount(account);
+                finishReally(); // l'accueil se recharge avec ce compte
+            });
+
+            mList.addView(item);
+        }
+    }
+
+    private void startSignIn() {
+        RxHelper.disposeActions(mSignInAction);
+        mCodeBox.setVisibility(View.VISIBLE);
+        mCode.setText("…");
+
+        mSignInAction = signIn().signInObserve()
+                .subscribe(
+                        code -> mCode.setText(code),
+                        error -> {
+                            Log.e(TAG, "Sign in error: %s", error.getMessage());
+                            mCode.setText(error.getMessage());
+                        },
+                        () -> {
+                            mCodeBox.setVisibility(View.GONE);
+                            mStatus.setText(R.string.liquid_sign_in_done);
+                            refreshAccounts();
+                        });
+    }
+}
